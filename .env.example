# Absolute origin used by metadata, robots.txt and sitemap.xml.
# Set this to the public URL (no trailing slash) before `next build`.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: writable SQLite location. Defaults to ./data/speedx.db, then the
# operating system temp directory if the project directory is not writable.
SPEEDX_DB_PATH="./data/speedx.db"
